{
  "expo": {
    "name": "TandT-deals",
    "slug": "TandT-deals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brandLogo.png",
    "scheme": "tandtdeals",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brandLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0e1525"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
